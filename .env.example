# NetBird personal access token or service-user token. The API uses Token auth.
NETBIRD_API_TOKEN=
NETBIRD_API_URL=https://api.netbird.io/api
NETBIRD_TIMEOUT_MS=30000

# stdio, sse, or http. Both network modes expose /sse and /mcp.
MCP_TRANSPORT=sse
MCP_HOST=127.0.0.1
MCP_PORT=3000
# Required in sse/http mode. Use a different secret from NETBIRD_API_TOKEN.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Hostnames only (no scheme/port). Add the public hostname when using a proxy.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Exact browser origins, comma-separated. Empty rejects all browser origins.
MCP_ALLOWED_ORIGINS=
MCP_MAX_SSE_SESSIONS=100
# Compose publishes only on localhost unless explicitly changed.
MCP_BIND_ADDRESS=127.0.0.1

# All mutations are removed by default. Set false to expose enabled writes.
NETBIRD_READ_ONLY=true
# Setting any feature to false removes its tools from every transport.
NETBIRD_ENABLE_PEERS=true
# Peer updates, deletions, and job creation; peer reads remain available.
NETBIRD_ENABLE_PEER_CONTROL=true
NETBIRD_ENABLE_GROUPS=true
NETBIRD_ENABLE_POLICIES=true
NETBIRD_ENABLE_ROUTES=true
NETBIRD_ENABLE_NETWORKS=true
NETBIRD_ENABLE_DNS=true
NETBIRD_ENABLE_SETUP_KEYS=true
NETBIRD_ENABLE_USERS=true
NETBIRD_ENABLE_ACCOUNTS=true
NETBIRD_ENABLE_EVENTS=true
NETBIRD_ENABLE_POSTURE_CHECKS=true
# Reverse proxy services, domains, clusters, tokens, and access logs.
NETBIRD_ENABLE_REVERSE_PROXY=true
